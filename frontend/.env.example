# Copy to frontend/.env. These values are PUBLIC (they only identify the Firebase
# project) — but still keep the file out of git for cleanliness.

# Paste your Firebase web config as a single-line JSON string.
# Firebase console > Project settings > General > Your apps > SDK setup (Config).
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}

# Leave blank in production (frontend served from the same origin as the API).
# For local dev the Vite proxy handles /api, so blank is also fine locally.
VITE_API_BASE=
